# Copy to .env and fill in real values:
#
#   cp .env.example .env
#   chmod 600 .env
#
# Every variable is optional except the two API keys. Defaults are chosen to be
# safe rather than convenient — see docs/configuration.md.

# --- Credentials --------------------------------------------------------------
# Generate each key separately, and never reuse one between the two roles:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# The service refuses to start on a key shorter than 32 characters or one that
# still looks like this example, so leaving the placeholders in place fails loudly
# instead of silently shipping a known credential.

# Clients that control relays (the phone app).
PIHOME_RELAY_API_KEY=replace-me-with-a-generated-key

# Sensor devices that push readings (ESP32 firmware). Kept separate so a key
# extracted from firmware cannot drive relays directly.
PIHOME_SENSOR_API_KEY=replace-me-with-a-different-generated-key

# --- HTTP server --------------------------------------------------------------
# Loopback by default. Set 0.0.0.0 only once you have decided how the service is
# reached from outside — read docs/security.md before you do.
PIHOME_HOST=127.0.0.1
PIHOME_PORT=5002

# --- Observability ------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
PIHOME_LOG_LEVEL=INFO
# Emit one JSON object per log line instead of human-readable text.
PIHOME_LOG_JSON=false
# Log every HTTP request. Off by default: on an exposed host this is mostly
# scanner noise, and it costs SD-card write cycles.
PIHOME_ACCESS_LOG=false

# --- API surface --------------------------------------------------------------
# Serve Swagger UI at /docs and the schema at /openapi.json. Useful locally;
# leave off in production so the deployment does not publish its own route map.
PIHOME_DOCS_ENABLED=false
