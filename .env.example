# Copy to .env and fill in real values:
#
#   cp .env.example .env
#   chmod 600 .env
#
# Every variable is optional except the two API keys. Defaults are chosen to be
# safe rather than convenient — README.md has the same list in table form.

# --- Credentials --------------------------------------------------------------
# Generate each key separately, and never reuse one between the two roles:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# The service refuses to start on a key shorter than 32 characters or one that
# still looks like this example, so leaving the placeholders in place fails loudly
# instead of silently shipping a known credential.

# Clients that control relays (the phone app).
PIHOME_RELAY_API_KEY=replace-me-with-a-generated-key

# Sensor devices that push readings (ESP32 firmware). Kept separate so a key
# extracted from firmware cannot drive relays directly.
PIHOME_SENSOR_API_KEY=replace-me-with-a-different-generated-key

# --- HTTP server --------------------------------------------------------------
# Loopback by default. Set 0.0.0.0 only once you have decided how the service is
# reached from outside — read SECURITY.md before you do.
PIHOME_HOST=127.0.0.1
PIHOME_PORT=5002

# --- Observability ------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
PIHOME_LOG_LEVEL=INFO
# Emit one JSON object per log line instead of human-readable text.
PIHOME_LOG_JSON=false
# Log every HTTP request. Off by default: on an exposed host this is mostly
# scanner noise, and it costs SD-card write cycles.
PIHOME_ACCESS_LOG=false

# --- API surface --------------------------------------------------------------
# Serve Swagger UI at /docs and the schema at /openapi.json.
#
# These carry no credential — Swagger UI has to fetch the schema before it could
# send one — so the service refuses to start with docs enabled unless PIHOME_HOST
# is a loopback address. To browse them against the Pi, forward the port:
#
#   ssh -L 5002:127.0.0.1:5002 pi
PIHOME_DOCS_ENABLED=false

# --- Web client ---------------------------------------------------------------
# Directory holding the built browser client (pihome-hub-web), served at /. Leave
# it unset and the hub serves its API and nothing else, which is what an API-only
# deployment wants.
#
# Point it at what the client's build wrote. A directory with no index.html in it
# stops the service with a line saying so, rather than becoming a 404 on the front
# page. Keep the bundle outside /home: the unit sets ProtectHome=yes, so a home
# directory is not there to be read.
# PIHOME_WEB_ROOT=/opt/pihome-hub-web/dist

# --- Hardware -----------------------------------------------------------------
# mock     — no GPIO at all; the default, and what tests and development use
# gpiozero — drive real pins (needs the rpi extra: pip install -e '.[rpi]')
#
# There is no auto-detect: if detection failed on a real Pi you would get a mock
# that silently switches nothing, so driving hardware is always explicit.
PIHOME_GPIO_BACKEND=mock

# Relay wiring, resolved relative to the process working directory. The systemd
# unit sets WorkingDirectory, so this path holds there too.
PIHOME_RELAY_CONFIG_PATH=config/relays.yaml

# Sensors and automation are optional. A missing file means the feature is simply
# not in use — the relay API works perfectly well on its own.
PIHOME_SENSOR_CONFIG_PATH=config/sensors.yaml
PIHOME_AUTOMATION_CONFIG_PATH=config/automation.yaml

# --- Devices ------------------------------------------------------------------
# HTTP devices this hub polls — the ESP32 in a PC case, and whatever joins it.
# Optional in exactly the same way: no file means no devices, and the rest of the
# service is unaffected. Which devices exist is declared here; where each one is
# gets announced by the device itself, because DHCP decides that and no file can.
PIHOME_DEVICE_CONFIG_PATH=config/devices.yaml

# How often each announced device is asked for its status, and how long one has to
# answer before it is recorded as unreachable. The timeout covers the whole
# exchange rather than each read, so a device answering one byte at a time cannot
# hold a poll open indefinitely.
PIHOME_DEVICE_POLL_SECONDS=30.0
PIHOME_DEVICE_POLL_TIMEOUT_SECONDS=5.0

# --- Accounts -----------------------------------------------------------------
# Where accounts live. Leave this unset on a Pi: the systemd unit declares
# StateDirectory=pihome-hub and exports STATE_DIRECTORY, which this follows, so the
# unit stays the one place the location is written down. Off systemd it falls back
# to var/hub.db beside the checkout. pihome-hub-admin reads the same variable.
# PIHOME_DATABASE_PATH=var/hub.db

# How long a login lasts, counted from the moment it happened rather than from the
# last request. Absolute rather than sliding, deliberately: renewing on use would
# mean a database write on every authenticated request, and this runs on an SD card.
# Thirty days by default, so a tablet on a kitchen wall is not asked again weekly.
PIHOME_SESSION_LIFETIME_SECONDS=2592000

# Whether the session cookie carries the Secure attribute. Leave this false unless
# something in front of the hub terminates TLS: this service speaks plain HTTP, and
# a Secure cookie is one the browser will not send over it — logging in would look
# like it worked and every request afterwards would be anonymous.
PIHOME_SESSION_COOKIE_SECURE=false

# --- Brute-force protection ---------------------------------------------------
# Failed authentication attempts one client address may make within the window
# before further attempts are refused with 429. Successful requests clear the
# count, so a working client cannot lock itself out.
PIHOME_AUTH_MAX_FAILURES=10
PIHOME_AUTH_FAILURE_WINDOW_SECONDS=300
