# Secrets and machine-specific configuration.
# Nothing matching these should ever reach a commit — see SECURITY.md.
.env
.env.*
!.env.example
*.pem
*.key

# Local device and automation configuration. Only the *.example.yaml templates
# are tracked; the real files describe a specific house and belong on that host.
config/*.yaml
config/*.yml
!config/*.example.yaml
!config/*.example.yml

# The state directory a development run writes into. Off systemd the database
# falls back to var/hub.db beside the checkout, and that file holds session
# tokens and every key a device has announced, in the clear — docs/devices.md
# says why the keys cannot be hashed. None of it belongs in a commit.
var/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
